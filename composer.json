{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Laravel Auth",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "creativeorange/gravatar": "^1.0",
        "cviebrock/eloquent-sluggable": "9.0",
        "doctrine/dbal": "^3.3",
        "fruitcake/laravel-cors": "^3.0",
        "google/recaptcha": "^1.2",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.7",
        "jaybizzle/laravel-crawler-detect": "^1.2",
        "jeremykenedy/laravel-blocker": "^3.4",
        "jeremykenedy/laravel-exception-notifier": "^3",
        "jeremykenedy/laravel-https": "^1.5",
        "jeremykenedy/laravel-logger": "^7.1",
        "jeremykenedy/laravel-phpinfo": "^1.3",
        "jeremykenedy/laravel-roles": "^9",
        "jeremykenedy/laravel2step": "^2.2",
        "jeremykenedy/uuid": "^3.1",
        "laravel/framework": "^9.0",
        "laravel/helpers": "^1.5",
        "laravel/passport": "^11",
        "laravel/sanctum": "^3",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^4",
        "laravelcollective/html": "^6.1",
        "laravolt/avatar": "^5.0",
        "league/csv": "^9.10",
        "livewire/livewire": "^2.12",
        "mckenziearts/laravel-notify": "^2.4",
        "oss-tools/laravel-libretranslate": "^1.0",
        "pusher/pusher-php-server": "^5.0",
        "rap2hpoutre/laravel-log-viewer": "^2.1",
        "rtconner/laravel-tagging": "^4.1",
        "shetabit/visitor": "^4.1",
        "shvetsgroup/laravel-email-database-log": "^10.0",
        "socialiteproviders/37signals": "^4.1",
        "socialiteproviders/generators": "^4.6",
        "socialiteproviders/instagram": "^4.1",
        "socialiteproviders/linkedin": "^4.1",
        "socialiteproviders/twitch": "^5.3",
        "socialiteproviders/youtube": "^4.1",
        "torann/geoip": "^3.0",
        "unisharp/laravel-filemanager": "^2.6",
        "yajra/laravel-datatables": "9.0",
        "yajra/laravel-datatables-oracle": "^10.8"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "barryvdh/laravel-ide-helper": "*",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan optimize",
            "@php artisan config:clear"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
